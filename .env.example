# Discord Webhooks
WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_MAIN_WEBHOOK
IMPORTANT_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_IMPORTANT_WEBHOOK

# Discord Bot (for creating events)
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN
DISCORD_GUILD_ID=YOUR_SERVER_ID

# Discord Roles (for pings)
DISCORD_ROLE_ID=YOUR_ROLE_ID
DISCORD_IMPORTANT_ROLE_ID=YOUR_IMPORTANT_ROLE_ID

# FIT Credentials
FIT_USERNAME=YOUR_STUDENT_ID
FIT_PASSWORD=YOUR_PASSWORD

# Imgur
IMGUR_CLIENT_ID=YOUR_IMGUR_CLIENT_ID

# Claude API (for date extraction)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Reddit (optional, a "script" app at reddit.com/prefs/apps; leave empty to skip)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=FITMostar

# Scraping interval (seconds)
INTERVAL=10
